---
import IntermittentHero from '@/components/IntermittentHero.astro';
import IntermittentFooter from '@/components/layout/footer/IntermittentFooter.astro';
import Layout from '@/layouts/Layout.astro';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "NovarenTech",
  "image": "https://novarentech.com/og-image.jpg",
  "@id": "https://novarentech.com",
  "url": "https://novarentech.com/en",
  "telephone": "+62211234567",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. Kesehatan No. 1",
    "addressLocality": "South Jakarta",
    "addressRegion": "DKI Jakarta",
    "postalCode": "12345",
    "addressCountry": "ID"
  }
};
---

<Layout
  title="Home"
  description="NovarenTech – Your trusted digital solution company providing top-notch technology services, web development, and digital transformation."
  jsonld={organizationSchema}
>
  <IntermittentHero />
  <IntermittentFooter client:visible/>
</Layout>
