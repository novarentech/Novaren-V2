---
import ScrollReveal from '@/components/ScrollReveal';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-black text-white font-sans min-h-screen flex flex-col justify-center py-32">
  <div class="container mx-auto px-6 md:px-12">
    <div class="flex flex-col text-base md:text-lg font-light text-gray-300">

      <div class="min-h-[10vh] flex items-center">
        <ScrollReveal
          baseOpacity={0.1}
          enableBlur={true}
          baseRotation={6}
          blurStrength={6}
          containerClassName="text-3xl md:text-5xl font-medium text-white tracking-tight leading-snug"
          client:only="react"
        >
          {`${t('footer_intermittent.title')} ${t('footer_intermittent.title_space')}`}
        </ScrollReveal>
      </div>

      <div class="mt-20 flex items-center">
        <ScrollReveal
          baseOpacity={0.1}
          enableBlur={true}
          baseRotation={6}
          blurStrength={6}
          containerClassName="leading-relaxed max-w-2xl"
          client:only="react"
        >
          {`${t('footer_intermittent.desc1')} ${t('footer_intermittent.desc2')} ${t('footer_intermittent.desc3')}`}
        </ScrollReveal>
      </div>

      <div class="mt-6 flex items-center">
        <ScrollReveal
          baseOpacity={0.1}
          enableBlur={true}
          baseRotation={6}
          blurStrength={6}
          client:only="react"
        >
          {t('footer_intermittent.time')}
        </ScrollReveal>
      </div>

      <div class="mt-6 flex items-center">
        <ScrollReveal
          baseOpacity={0.1}
          enableBlur={true}
          baseRotation={6}
          blurStrength={6}
          containerClassName="leading-relaxed"
          client:only="react"
        >
          {`${t('footer_intermittent.thanks')} ${t('footer_intermittent.ready')}`}
        </ScrollReveal>
      </div>

      <div class="mt-20 flex items-center">
        <ScrollReveal
          baseOpacity={0.1}
          enableBlur={true}
          baseRotation={6}
          blurStrength={6}
          containerClassName="pt-8"
          client:only="react"
        >
          <div class="font-semibold text-white text-lg space-y-4">
            <p>{t('footer_intermittent.regards')}</p>
            <p>Novaren Tech</p>
          </div>
        </ScrollReveal>
      </div>

    </div>
  </div>
</footer>


